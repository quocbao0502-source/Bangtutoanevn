{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/hotline", "destination": "/index.html" },
    { "source": "/estimate", "destination": "/index.html" },
    { "source": "/hotline-estimate", "destination": "/index.html" }
  ]
}
